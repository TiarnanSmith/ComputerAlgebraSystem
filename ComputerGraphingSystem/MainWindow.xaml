<Window x:Class="ComputerGraphingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ComputerGraphingSystem.Views"
        xmlns:vms="clr-namespace:ComputerGraphingSystem.ViewModels"
        mc:Ignorable="d"
        Title="MainWindow" Height="1920" Width="1080">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <!--https://stackoverflow.com/a/18930412/17302244-->
        <Grid Grid.Row="1"> 
            <Grid.Resources>
                <DataTemplate  DataType="{x:Type vms:GraphCanvasViewModel}">
                    <views:GraphCanvasView/>
                </DataTemplate>
            </Grid.Resources>

            <Grid>
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
